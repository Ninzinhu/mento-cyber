rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function participant(data) { return signedIn() && (data.senderId == request.auth.uid || data.recipientId == request.auth.uid); }
    function moderator() {
      return signedIn() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['moderator', 'admin'];
    }

    // The Next.js server writes with Firebase Admin SDK. Browser clients only read.
    match /profiles/{userId} { allow read: if owner(userId); allow write: if false; }
    match /memberProfiles/{userId} { allow read: if true; allow write: if false; }
    match /missions/{missionId} { allow read: if resource.data.visibility == 'public' || signedIn(); allow write: if false; }
    match /contributions/{contributionId} { allow read: if signedIn() && (resource.data.authorId == request.auth.uid || moderator()); allow write: if false; }
    match /profileFollows/{followId} { allow read: if signedIn(); allow write: if false; }
    match /profileInvites/{inviteId} { allow read: if participant(resource.data); allow write: if false; }
    match /interestRequests/{requestId} { allow read: if moderator(); allow write: if false; }
    match /memberReports/{reportId} { allow read: if moderator(); allow write: if false; }
    match /labProgress/{progressId} { allow read: if owner(resource.data.uid); allow write: if false; }
    match /labEvidence/{evidenceId} { allow read: if owner(resource.data.uid) || moderator(); allow write: if false; }
    match /labReviews/{reviewId} { allow read, write: if false; }
    match /contentPosts/{postId} { allow read: if resource.data.status == 'published'; allow write: if false; }
    match /contentComments/{commentId} { allow read: if resource.data.status == 'published'; allow write: if false; }
    match /contentReactions/{reactionId} { allow read: if signedIn(); allow write: if false; }
    match /newsletterSubscribers/{subscriberId} { allow read, write: if false; }
  }
}
